# Booking is handled entirely through the embedded Calendly widget
# (see src/lib/site.ts: calendarUrl) and needs no env vars.

# Mailchimp — powers the "AI Readiness Checklist" email signup form
# (footer + Community page). Until all three are set, submissions are
# accepted and logged server-side but not actually delivered anywhere.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Google Analytics 4. Leave unset to keep GA4 inactive.
NEXT_PUBLIC_GA_ID=

# LinkedIn Insight Tag. Leave unset to keep it inactive.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Stripe Payment Link for the AI Foundations course checkout. Not
# currently linked from any page (AI Foundations shows "Coming soon"
# on /workshops until enrollment is approved), but the site reads this
# var in src/lib/site.ts whenever that CTA is wired back up.
NEXT_PUBLIC_STRIPE_FOUNDATIONS_URL=
