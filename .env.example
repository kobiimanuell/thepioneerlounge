# Booking is handled entirely through the embedded Calendly widget
# (see src/lib/site.ts: calendarUrl) and needs no env vars.

# Mailgun — powers the "AI Readiness Checklist" email signup form
# (footer + Community page). Sends the checklist to the signer, notifies
# info@thepioneerlounge.com, and optionally records the signup to a
# mailing list. Until the first two are set, submissions are accepted
# and logged server-side but nothing is actually sent.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional: a Mailgun mailing list address, for record-keeping only.
MAILGUN_LIST_ADDRESS=
# Optional: defaults to hello@<MAILGUN_DOMAIN>.
MAILGUN_FROM_EMAIL=
# Optional: EU Mailgun accounts use https://api.eu.mailgun.net/v3.
MAILGUN_BASE_URL=

# Google Analytics 4. Leave unset to keep GA4 inactive.
NEXT_PUBLIC_GA_ID=

# LinkedIn Insight Tag. Leave unset to keep it inactive.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Stripe Payment Link for the AI Foundations course checkout. Not
# currently linked from any page (AI Foundations shows "Coming soon"
# on /workshops until enrollment is approved), but the site reads this
# var in src/lib/site.ts whenever that CTA is wired back up.
NEXT_PUBLIC_STRIPE_FOUNDATIONS_URL=
